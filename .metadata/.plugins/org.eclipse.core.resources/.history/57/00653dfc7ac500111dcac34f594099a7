

void SoftI2C_Start(){
	HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, 1);
	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, 1);

	HAL_Delay(100);
	HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, 0);
	HAL_Delay(100);
	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, 1);



}

