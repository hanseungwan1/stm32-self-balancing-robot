static void I2C_Delay(void)
{
    for (volatile uint32_t i = 0; i < 100; i++)
    {
        __NOP();
    }
}

void SoftI2C_Start(){
	HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, GPIO_PIN_SET);
	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_SET);

	I2C_Delay();
	HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, GPIO_PIN_RESET);
	I2C_Delay();
	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_RESET);



}

void SoftI2C_Stop(){
	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, GPIO_PIN_RESET);
	I2C_Delay();

	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_SET);
	I2C_Delay();
	HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, GPIO_PIN_SET);

}

void SoftI2C_WriteByte(uint8_t data){
    for (uint8_t i = 0; i < 8; i++)
    {
    	if(data & 0x80){
    		HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, GPIO_PIN_SET);
    	} else {
    		HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, GPIO_PIN_RESET);
    	}
    	data <<= 1;

    	I2C_Delay();

    	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_SET);
    	I2C_Delay();
    	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_RESET);
    }
}

uint8_t SoftI2C_WaitAck(){
	HAL_GPIO_WritePin(MPU_SDA_GPIO_Port, MPU_SDA_Pin, GPIO_PIN_SET);
	I2C_Delay();

	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_SET);
	I2C_Delay();

	uint8_t data = HAL_GPIO_ReadPin(MPU_SDA_GPIO_Port, MPU_SDA_Pin);
	HAL_GPIO_WritePin(MPU_SCL_GPIO_Port, MPU_SCL_Pin, GPIO_PIN_RESET);

	return data;

}

