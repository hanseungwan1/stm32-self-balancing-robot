//START
//통신 시작
//
//
//0xD0 전송 → ACK 확인
//MPU6050 주소 + 쓰기 요청
//
//
//0x75 전송 → ACK 확인
//읽고 싶은 레지스터 지정
//
//
//Repeated START
//STOP 없이 다시 START
//
//
//0xD1 전송 → ACK 확인
//MPU6050 주소 + 읽기 요청
//
//1바이트 읽기 → NACK → STOP
//센서 식별값 수신 후 통신 종료
#include "soft_i2c.h"
#include "mpu6050.h"
#include "stddef.h"

uint8_t MPU6050_ReadReg(uint8_t reg)
{

    uint8_t data = 0;

    SoftI2C_Start();
    SoftI2C_WriteByte(0xD0);

    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
    	return 0;
    }

    SoftI2C_WriteByte(reg);

    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
    	return 0;
    }

    SoftI2C_Start();
    SoftI2C_WriteByte(0xD1);

    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
    	return 0;
    }
    data = SoftI2C_ReadByte();
    SoftI2C_SendAck(1);

    SoftI2C_Stop();


    return data;
}

void MPU6050_WriteReg(uint8_t reg, uint8_t data)
{
    SoftI2C_Start();
    SoftI2C_WriteByte(0xD0);

    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
        return;
    }

    SoftI2C_WriteByte(reg);
    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
        return;
    }

    SoftI2C_WriteByte(data);
    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
        return;
    }

    SoftI2C_Stop();

}

void MPU6050_ReadBytes(uint8_t reg, uint8_t *buffer, uint8_t len){
	if(len == 0 || buffer == NULL){
		return;
	}

    SoftI2C_Start();
    SoftI2C_WriteByte(0xD0);

    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
        return;
    }

    SoftI2C_WriteByte(reg);

    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
    	return;
    }

    SoftI2C_Start();
    SoftI2C_WriteByte(0xD1);

    if(SoftI2C_WaitAck() != 0){
    	printf("mpu6050 ack 응답 실패");
        SoftI2C_Stop();
    	return;
    }


    for(uint8_t i = 0; i < len; i++ ){
    	buffer[0] = SoftI2C_ReadByte();

    	if(i + 1 == len){
    	    SoftI2C_SendAck(0);
    	    SoftI2C_Stop();
    	    return;
    	}

        SoftI2C_SendAck(1);


    }

    data = SoftI2C_ReadByte();
    SoftI2C_SendAck(1);

    SoftI2C_Stop();


    return data;

}

