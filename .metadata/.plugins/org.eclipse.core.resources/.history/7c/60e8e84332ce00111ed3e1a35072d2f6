/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */

  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_USART1_UART_Init();
  MX_TIM6_Init();
  MX_TIM3_Init();
  MX_TIM4_Init();
  MX_TIM8_Init();
  /* USER CODE BEGIN 2 */

  HAL_TIM_Encoder_Start(&htim3, TIM_CHANNEL_ALL);
  HAL_TIM_Encoder_Start(&htim4, TIM_CHANNEL_ALL);

  prevLeftEncoderCnt = __HAL_TIM_GET_COUNTER(&htim3);
  prevRightEncoderCnt = __HAL_TIM_GET_COUNTER(&htim4);

  HAL_TIM_Base_Start_IT(&htim6);

  // 모터 PWM ?��?��
  HAL_TIM_PWM_Start(&htim8, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim8, TIM_CHANNEL_2);
  HAL_TIM_PWM_Start(&htim8, TIM_CHANNEL_3);
  HAL_TIM_PWM_Start(&htim8, TIM_CHANNEL_4);

  HAL_Delay(500);  // ?��?�� ?��?�� ?��?��?�� ??�?

  printf("\r\n=== MPU6050 I2C TEST ===\r\n");

  printf("SCL=%d, SDA=%d\r\n",
         HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_10),
         HAL_GPIO_ReadPin(GPIOB, GPIO_PIN_11));

  MPU6050_WriteReg(0x6B, 0x00);
  HAL_Delay(2000);               // 2초 동안 기다리기
  float gyro_bias = MPU6050_CalibrateGyroX();

  printf("Gyro X Bias = %.2f\r\n", gyro_bias);
  float angle = 0.0f;
  uint8_t angle_initialized = 0;
  uint32_t print_count = 0;
//  Motor_Set(1500, 1500);
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {

	    if (imu_flag)
	    {
	        imu_flag = 0;

	        uint8_t imu_buffer[14] = {0};


	        // MPU6050 데이터 14바이트 읽기
	        MPU6050_ReadBytes(0x3B, imu_buffer, 14);

	        // 센서 RAW 데이터 추출
	        int16_t accel_x =
	            (int16_t)((imu_buffer[0] << 8) | imu_buffer[1]);

	        int16_t accel_y =
	            (int16_t)((imu_buffer[2] << 8) | imu_buffer[3]);

	        int16_t accel_z =
	            (int16_t)((imu_buffer[4] << 8) | imu_buffer[5]);

	        int16_t gyro_x =
	            (int16_t)((imu_buffer[8] << 8) | imu_buffer[9]);

	        // 각도 및 각속도 계산
	        float accel_angle =
	            Attitude_GetAccelAngle(accel_y, accel_z);

	        float gyro_rate =
	            Attitude_GetGyroRate(gyro_x, gyro_bias);

	        if (angle_initialized == 0)
	        {
	            angle = accel_angle;
	            angle_initialized = 1;
	        }
	        else
	        {
	            angle = Attitude_ComplementaryFilter(
	                angle,
	                gyro_rate,
	                accel_angle,
	                0.01f
	            );

	            float p_control = PID_P(TARGET_ANGLE, angle, 50.0f);
	            float d_control = PID_D(gyro_rate, 5.0f);

	            float pd_output = p_control + d_control;

	            if (angle > 20.0f || angle < -20.0f)
	            {
	                Motor_Set(0, 0);
	            }
	            else
	            {
	            	if(pd_output > 0){
	            		pd_output += 1500;
	            		if(pd_output > 2879){
	            			pd_output = 2879;
	            		}
	            	} else if(pd_output < 0){
	            		pd_output -= 1500;
	            		if(pd_output < -2879){
	            			pd_output = -2879;
	            		}
	            	}
	                Motor_Set((int)pd_output, (int)pd_output);
	            }

	        }
		    if (++print_count >= 10)
		    {
		        print_count = 0;

		    }
	    }

    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */

  }
  /* USER CODE END 3 */
}

